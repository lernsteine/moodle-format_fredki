{{!
    @template format_fredki/termpop

    Small card with the definition of a term, shown at the term.

    Example context (json):
    {"concept": "Photosynthesis", "ai": true, "ailabel": "by FredKI", "definition": "How plants make sugar from light.", "morelabel": "All definitions"}
}}
<div class="ffk-termpop__head"><strong>{{concept}}</strong>{{#ai}}<span class="ffk-ai-chip">{{ailabel}}</span>{{/ai}}</div><p>{{definition}}</p><button type="button" class="ffk-termpop__more" data-defterm="{{concept}}">{{morelabel}}</button>
