{{!
    @template format_fredki/topicline

    The topic field of a conversation on its card.

    Example context (json):
    {"sorting": false, "sortinglabel": "FredKI is sorting", "topicid": 3, "name": "Light"}
}}
{{#sorting}}<span class="ffk-topictag ffk-topictag--sorting"><span class="ffk-orb ffk-orb--xs" aria-hidden="true"></span>{{sortinglabel}}</span>{{/sorting}}{{^sorting}}{{#topicid}}<button type="button" class="ffk-topictag" data-action="topicfilter" data-topic="{{topicid}}">{{name}}</button>{{/topicid}}{{/sorting}}
