{{!
    @template format_fredki/avatar

    Picture of a person, or initials on a calm colour.

    Example context (json):
    {
        "hasavatar": false,
        "avatarurl": "",
        "initials": "LH",
        "colour": "c1",
        "fullname": "Lena Hoffmann"
    }
}}
{{#hasavatar}}<img class="ffk-av" src="{{avatarurl}}" alt="" title="{{fullname}}">{{/hasavatar}}{{^hasavatar}}<span class="ffk-av ffk-av--{{colour}}" title="{{fullname}}" aria-hidden="true">{{initials}}</span>{{/hasavatar}}
