{{!
    @template format_fredki/conversation

    A whole conversation of the learning group, opened on the course page instead of the forum.

    Example context (json):
    {
        "discussionid": 5, "postid": 12, "lastpersonpost": 12, "url": "#", "subject": "Wie viel Budget brauchen wir?",
        "body": "Für die Pflege der Grünflächen.", "image": "https://example.com/lake.jpg", "type": "question",
        "typelabel": "Frage", "hastype": true, "time": "vor 2 Std.", "likes": 1, "liked": false, "replycount": 1,
        "author": {"firstname": "Lena", "fullname": "Lena Hoffmann", "initials": "LH", "colour": "c1", "hasavatar": false},
        "replies": [], "canreply": true, "canconvene": true, "canmoderate": false, "hasnextagents": false, "nextagents": []
    }
}}
<article class="ffk-conv" data-region="card" data-view="full" data-canfredki="{{#hasfredki}}1{{/hasfredki}}" data-discussionid="{{discussionid}}" data-postid="{{postid}}" data-lastpost="{{lastpersonpost}}" data-type="{{type}}" aria-labelledby="ffk-conv-title-{{discussionid}}">
    <div class="ffk-conv__band" style="background-image: url('{{image}}')" aria-hidden="true"></div>
    <button type="button" class="ffk-conv__close" data-action="closeconv" title="{{#str}}closeconversation, format_fredki{{/str}}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
        <span class="sr-only">{{#str}}closeconversation, format_fredki{{/str}}</span>
    </button>
    <div class="ffk-conv__in">
        <div class="ffk-who">
            {{#byfredki}}<span class="ffk-orb ffk-orb--xs" aria-hidden="true"></span><span>FredKI</span>{{/byfredki}}
            {{^byfredki}}{{#author}}{{> format_fredki/avatar }}{{/author}}
            <span>{{author.fullname}}</span>{{/byfredki}}
            <span aria-hidden="true">·</span>
            <span>{{time}}</span>
            {{#hastype}}<span class="ffk-type ffk-type--{{type}}">{{typelabel}}</span>{{/hastype}}
        </div>
        <div class="ffk-say-row"><h2 class="ffk-conv__title" id="ffk-conv-title-{{discussionid}}">{{subject}}</h2>{{> format_fredki/pen }}</div>
        {{#body}}<p class="ffk-conv__text">{{body}}</p>{{/body}}
        <div class="ffk-card__actions">
            <button type="button" class="ffk-ic{{#liked}} is-on{{/liked}}" data-action="like" aria-pressed="{{#liked}}true{{/liked}}{{^liked}}false{{/liked}}" title="{{#str}}helpful, format_fredki{{/str}}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
                <span data-region="likecount">{{likes}}</span>
                <span class="sr-only">{{#str}}helpful, format_fredki{{/str}}</span>
            </button>
            <span class="ffk-conv__count"><span data-region="replycount">{{replycount}}</span> {{#str}}answers, format_fredki{{/str}}</span>
        </div>
        {{#hasmaturity}}
        <section class="ffk-matpanel ffk-matpanel--{{maturitylevel}}" aria-label="{{#str}}maturity, format_fredki{{/str}}">
            <div class="ffk-matpanel__gauge">
                        <svg class="ffk-gauge ffk-gauge--{{maturitylevel}}" viewBox="0 0 120 68" aria-hidden="true" focusable="false">
                    <path class="ffk-gauge__track" d="M12 60 A48 48 0 0 1 108 60" pathLength="100"/>
                    <path class="ffk-gauge__fill" d="M12 60 A48 48 0 0 1 108 60" pathLength="100" stroke-dasharray="{{maturityscore}} 100"/>
                    <g class="ffk-gauge__needle" transform="rotate({{maturityangle}} 60 60)"><path d="M60 60 L60 20"/><circle cx="60" cy="60" r="5"/></g>
                </svg>
                <div>
                    <div class="ffk-matpanel__kicker">{{#str}}maturity, format_fredki{{/str}}</div>
                    <div class="ffk-matpanel__level">{{maturitylabel}}</div>
                </div>
            </div>
            <ul class="ffk-matpanel__aspects">
                {{#maturityaspects}}<li><span>{{name}}</span><span class="ffk-matpanel__bar" role="img" aria-label="{{name}}: {{value}} / 4"><i style="width: {{percent}}%"></i></span></li>{{/maturityaspects}}
            </ul>
            {{#hasmaturityhint}}<p class="ffk-matpanel__hint"><strong>{{#str}}maturity_next, format_fredki{{/str}}</strong> {{maturityhint}}</p>{{/hasmaturityhint}}
            <p class="ffk-matpanel__note">{{#str}}maturity_note, format_fredki{{/str}}</p>
        </section>
        {{/hasmaturity}}
        <div class="ffk-card__notes ffk-conv__notes" data-region="notes" aria-live="polite">
            {{#replies}}{{> format_fredki/reply }}{{/replies}}
        </div>
        {{#canreply}}
        <form class="ffk-inline ffk-conv__form" data-region="replyform" data-withagent="0" data-parentid="0">
            <div class="ffk-replyhead">
                <span data-region="replyhead" data-default="{{#str}}replyto, format_fredki, {{#byfredki}}FredKI{{/byfredki}}{{^byfredki}}{{author.firstname}}{{/byfredki}}{{/str}}">{{#str}}replyto, format_fredki, {{#byfredki}}FredKI{{/byfredki}}{{^byfredki}}{{author.firstname}}{{/byfredki}}{{/str}}</span>
                <button type="button" class="ffk-replyhead__reset" data-action="replyreset" hidden title="{{#str}}replyall, format_fredki{{/str}}">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    <span class="sr-only">{{#str}}replyall, format_fredki{{/str}}</span>
                </button>
            </div>
            <div class="ffk-agentpick" data-region="agentpick" role="group" aria-label="{{#str}}whoanswers, format_fredki{{/str}}" hidden></div>
            <label class="sr-only" for="ffk-convreply-{{discussionid}}">{{#str}}reply, format_fredki{{/str}}</label>
            <textarea id="ffk-convreply-{{discussionid}}" class="ffk-grow" rows="1" autocomplete="off" maxlength="6000" placeholder="{{#str}}replyplaceholder, format_fredki, {{author.firstname}}{{/str}}"></textarea>
            <button type="submit" class="ffk-ic ffk-ic--solid">{{#str}}send, format_fredki{{/str}}</button>
        </form>
        {{/canreply}}
        {{#canmoderate}}<a class="ffk-conv__forum" href="{{url}}">{{#str}}openinforum, format_fredki{{/str}}</a>{{/canmoderate}}
    </div>
</article>
