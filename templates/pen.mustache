{{!
    @template format_fredki/pen

    Small pencil to correct an own post shortly after writing it.

    Example context (json):
    {
        "canedit": true,
        "postid": 12,
        "edituntil": 1793815000
    }
}}
{{#canedit}}<button type="button" class="ffk-pen" data-action="edit" data-postid="{{postid}}" data-until="{{edituntil}}" title="{{#str}}edit, format_fredki{{/str}}" aria-label="{{#str}}edit, format_fredki{{/str}}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>{{/canedit}}
