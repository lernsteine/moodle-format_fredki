{{!
    @template format_fredki/topicmenu

    Small menu to choose, create or let FredKI suggest the topic field of a conversation.

    Example context (json):
    {"items": [{"id": 3, "name": "Light", "on": true}], "current": 3, "nonelabel": "No topic field", "createlabel": "New topic field", "newlabel": "Add", "hasfredki": true, "suggestlabel": "FredKI suggests"}
}}
<div class="ffk-topicmenu__list">{{#items}}<button type="button" class="ffk-topicmenu__item{{#on}} is-on{{/on}}" data-topic="{{id}}" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}">{{name}}</button>{{/items}}{{#current}}<button type="button" class="ffk-topicmenu__item ffk-topicmenu__item--none" data-topic="0">{{nonelabel}}</button>{{/current}}</div><form class="ffk-topicmenu__new"><label class="sr-only" for="ffk-topicmenu-new">{{createlabel}}</label><input id="ffk-topicmenu-new" type="text" maxlength="40" autocomplete="off" placeholder="{{createlabel}}"><button type="submit">{{newlabel}}</button></form>{{#hasfredki}}<button type="button" class="ffk-topicmenu__suggest" data-suggest="1"><span class="ffk-orb ffk-orb--xs" aria-hidden="true"></span>{{suggestlabel}}</button>{{/hasfredki}}
