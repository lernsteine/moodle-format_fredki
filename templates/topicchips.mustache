{{!
    @template format_fredki/topicchips

    Chips to filter the wall by topic field.

    Example context (json):
    {"chips": [{"id": 0, "label": "All", "on": true, "hascount": false}, {"id": 3, "label": "Light", "count": 4, "hascount": true}, {"id": -1, "label": "Without topic", "count": 2, "hascount": true, "without": true}]}
}}
{{#chips}}<button type="button" class="ffk-topicchip{{#without}} ffk-topicchip--without{{/without}}{{#on}} is-active{{/on}}" data-action="topicfilter" data-topic="{{id}}" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}">{{label}}{{#hascount}} <span class="ffk-topicchip__n">{{count}}</span>{{/hascount}}</button>{{/chips}}
