{{!
    @template format_fredki/step

    One learning step: its image, FredKI with questions for this step, the materials, the group.

    Example context (json):
    {
        "courseid": 2,
        "coursename": "KI im Arbeitsalltag",
        "courseurl": "#",
        "stagename": "Erkunden",
        "position": 1,
        "total": 4,
        "heroimage": "https://example.com/1.jpg",
        "hasherovideo": false,
        "hasherotext": true,
        "herotext": "Sammle eigene Erfahrungen.",
        "hasfredki": true,
        "botname": "FredKI",
        "starters": [],
        "hasactivities": true,
        "activities": [{"name": "Kurzvideo", "url": "#", "haslink": true, "icon": "#", "type": "Video"}],
        "hascommunity": true,
        "cards": [],
        "people": {"show": false},
        "links": {"items": [], "canedit": false}
    }
}}
<div class="ffk ffk--step ffk--{{cardstyle}}{{#cardbright}} ffk--bright{{/cardbright}}" data-region="format-fredki" data-courseid="{{courseid}}">
    {{> format_fredki/topbar }}

    <section class="ffk-hero ffk-hero--step" aria-labelledby="ffk-stepname">
        {{#hasherovideo}}<video class="ffk-hero__media" src="{{herovideo}}" poster="{{heroimage}}" autoplay muted loop playsinline aria-hidden="true"></video>{{/hasherovideo}}
        {{^hasherovideo}}<img class="ffk-hero__media" src="{{heroimage}}" alt="">{{/hasherovideo}}
        <div class="ffk-hero__in">
            <a class="ffk-back" href="{{courseurl}}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
                {{#str}}backtospace, format_fredki{{/str}}
            </a>
            <div class="ffk-eyebrow">{{#str}}stepof, format_fredki, { "pos": {{position}}, "total": {{total}} }{{/str}}</div>
            <h2 class="ffk-hero__q" id="ffk-stepname">{{stagename}}</h2>
            {{#hasherotext}}<p class="ffk-hero__text">{{herotext}}</p>{{/hasherotext}}
            {{> format_fredki/askbar }}
        </div>
    </section>

    {{#hasactivities}}
    <section class="ffk-acts" aria-label="{{#str}}materials, format_fredki{{/str}}">
        {{#activities}}
            {{#istext}}<div class="ffk-act ffk-act--text">{{{content}}}</div>{{/istext}}
            {{^istext}}
                {{#haslink}}<a class="ffk-act{{#complete}} is-complete{{/complete}}" href="{{url}}">{{/haslink}}
                {{^haslink}}<div class="ffk-act is-restricted">{{/haslink}}
                    <span class="ffk-act__icon"><img src="{{icon}}" alt=""></span>
                    <span class="ffk-act__main">
                        <span class="ffk-act__name">{{name}}</span>
                        <span class="ffk-act__type">{{type}}</span>
                        {{#restricted}}{{#availability}}<span class="ffk-act__avail">{{{availability}}}</span>{{/availability}}{{/restricted}}
                    </span>
                    {{#hascompletion}}
                    <span class="ffk-act__check{{#complete}} is-on{{/complete}}" title="{{#complete}}{{#str}}done, format_fredki{{/str}}{{/complete}}{{^complete}}{{#str}}open, format_fredki{{/str}}{{/complete}}">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12l5 5L20 7"/></svg>
                        <span class="sr-only">{{#complete}}{{#str}}done, format_fredki{{/str}}{{/complete}}{{^complete}}{{#str}}open, format_fredki{{/str}}{{/complete}}</span>
                    </span>
                    {{/hascompletion}}
                {{#haslink}}</a>{{/haslink}}{{^haslink}}</div>{{/haslink}}
            {{/istext}}
        {{/activities}}
    </section>
    {{/hasactivities}}

    <nav class="ffk-stepnav" aria-label="{{#str}}path, format_fredki{{/str}}">
        {{#prev}}<a class="ffk-stepnav__item" href="{{url}}"><img src="{{image}}" alt=""><span><small>{{#str}}previousstep, format_fredki{{/str}}</small>{{name}}</span></a>{{/prev}}
        {{^prev}}<span></span>{{/prev}}
        {{#next}}<a class="ffk-stepnav__item ffk-stepnav__item--next" href="{{url}}"><img src="{{image}}" alt=""><span><small>{{#str}}nextstep, format_fredki{{/str}}</small>{{name}}</span></a>{{/next}}
    </nav>

    {{#hasstepforum}}
    <section class="ffk-round ffk-stepround" id="schritt-gespraech" aria-labelledby="ffk-step-round-title">
        <div class="ffk-bar">
            <h3 class="ffk-h" id="ffk-step-round-title">{{stepforumname}}</h3>
        </div>
        <p class="ffk-stepnote">{{#str}}stepforum_intro, format_fredki{{/str}}</p>
        {{#canpoststep}}
        <div class="ffk-groupstage">
            <form class="ffk-share" data-region="composer" data-forumid="{{stepforumid}}">
                <fieldset class="ffk-kinds">
                    <legend class="sr-only">{{#str}}kind, format_fredki{{/str}}</legend>
                    {{#types}}
                    <label class="ffk-kind"><input type="radio" name="ffk-kind" value="{{value}}"{{#checked}} checked{{/checked}}><span>{{label}}</span></label>
                    {{/types}}
                </fieldset>
                <label class="sr-only" for="ffk-step-share">{{#str}}stepforum_share, format_fredki{{/str}}</label>
                <textarea id="ffk-step-share" class="ffk-grow" rows="1" autocomplete="off" maxlength="6000" placeholder="{{#str}}stepforum_placeholder, format_fredki{{/str}}"></textarea>
                <button type="submit">{{#str}}share, format_fredki{{/str}}</button>
            </form>
        </div>
        {{/canpoststep}}
        <div class="ffk-wall" data-region="wall" data-forumid="{{stepforumid}}">
            {{#stepcards}}{{> format_fredki/card }}{{/stepcards}}
        </div>
        {{^hasstepcards}}<p class="ffk-empty" data-region="nocards">{{#str}}stepforum_empty, format_fredki{{/str}}</p>{{/hasstepcards}}
    </section>
    {{/hasstepforum}}
    {{^hasstepforum}}{{#canaddstepforum}}
    <p class="ffk-stepadd"><a href="{{addstepforumurl}}">{{#str}}stepforum_add, format_fredki{{/str}}</a> – {{#str}}stepforum_add_hint, format_fredki{{/str}}</p>
    {{/canaddstepforum}}{{/hasstepforum}}

    {{#hascoursetiles}}
    <section class="ffk-coursetiles" aria-labelledby="ffk-course-round-title">
        <div class="ffk-bar">
            <h3 class="ffk-h ffk-h--small" id="ffk-course-round-title">{{#str}}round, format_fredki{{/str}}</h3>
            <a class="ffk-more ffk-more--inline" href="{{courseurl}}#runde">{{#str}}step_allconversations, format_fredki{{/str}}</a>
        </div>
        <div class="ffk-shelves" data-region="shelves">
            {{#courseshelves}}
            <section class="ffk-shelf"{{#hasname}} aria-labelledby="ffk-cshelf-{{topicid}}"{{/hasname}}{{^hasname}} aria-label="{{#str}}round, format_fredki{{/str}}"{{/hasname}}>
                {{#hasname}}
                <header class="ffk-shelf__head">
                    <h4 class="ffk-shelf__name" id="ffk-cshelf-{{topicid}}">{{name}}</h4>
                    <span class="ffk-shelf__count">{{countlabel}}</span>
                    <a class="ffk-shelf__all" href="{{allurl}}" aria-label="{{#str}}topic_showall_label, format_fredki, {{name}}{{/str}}">{{#str}}topic_showall, format_fredki{{/str}}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                </header>
                {{/hasname}}
                <div class="ffk-shelf__tiles">{{#cards}}{{> format_fredki/shelftile }}{{/cards}}</div>
            </section>
            {{/courseshelves}}
        </div>
    </section>
    {{/hascoursetiles}}
</div>
