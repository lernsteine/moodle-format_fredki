{{!
    @template format_fredki/shelftile

    A conversation on the shelf of a topic field: small picture, question, who answered, maturity.

    Example context (json):
    {
        "discussionid": 5,
        "subject": "Why are there no long-lasting products?",
        "image": "https://example.com/lake.jpg",
        "type": "question",
        "byfredki": false,
        "author": {"firstname": "Lena"},
        "time": "vor 2 Std.",
        "replycount": 3,
        "hasvoices": false,
        "voices": [],
        "hasmaturity": false
    }
}}
<article class="ffk-tile" data-region="tile" data-discussionid="{{discussionid}}" data-type="{{type}}" data-byfredki="{{#byfredki}}1{{/byfredki}}{{^byfredki}}0{{/byfredki}}">
    <span class="ffk-tile__pic"><img class="ffk-tile__img" src="{{image}}" alt="" loading="lazy"{{#imagestyle}} style="{{imagestyle}}"{{/imagestyle}}></span>
    <div class="ffk-tile__body">
        <a class="ffk-tile__say" href="#gespraech-{{discussionid}}" data-action="opentile" data-discussionid="{{discussionid}}">{{subject}}</a>
        <div class="ffk-tile__meta">
            <span>{{#byfredki}}FredKI{{/byfredki}}{{^byfredki}}{{author.firstname}}{{/byfredki}} · {{time}}</span>
            {{#hasvoices}}<span class="ffk-voices__faces" aria-hidden="true">{{#voices}}{{#isagent}}<img class="ffk-av ffk-av--agent" src="{{image}}" alt="" style="border-color: {{colour}}">{{/isagent}}{{#isfredki}}<span class="ffk-orb ffk-orb--xs"></span>{{/isfredki}}{{#isperson}}{{#person}}{{> format_fredki/avatar }}{{/person}}{{/isperson}}{{/voices}}</span>{{/hasvoices}}
            <span class="ffk-tile__n"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>{{replycount}}<span class="sr-only"> {{#str}}answers, format_fredki{{/str}}</span></span>
            {{#hasmaturity}}<span class="ffk-maturity ffk-maturity--{{maturitylevel}}" title="{{#str}}maturity_title, format_fredki{{/str}}: {{maturitylabel}}"><span class="ffk-maturity__steps" aria-hidden="true">{{#maturitysteps}}<i{{#on}} class="is-on"{{/on}}></i>{{/maturitysteps}}</span><span class="sr-only">{{#str}}maturity, format_fredki{{/str}}: {{maturitylabel}}</span></span>{{/hasmaturity}}
        </div>
    </div>
</article>
