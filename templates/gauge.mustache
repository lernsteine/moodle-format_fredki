{{!
    @template format_fredki/gauge

    Half-round gauge (like a speedometer) of the maturity of a discussion.

    Example context (json):
    {"score": 62, "angle": 22, "label": "Vertieft", "level": "deepening"}
}}
<svg class="ffk-gauge ffk-gauge--{{level}}" viewBox="0 0 120 68" aria-hidden="true" focusable="false">
    <path class="ffk-gauge__track" d="M12 60 A48 48 0 0 1 108 60" pathLength="100"/>
    <path class="ffk-gauge__fill" d="M12 60 A48 48 0 0 1 108 60" pathLength="100" stroke-dasharray="{{score}} 100"/>
    <g class="ffk-gauge__needle" transform="rotate({{angle}} 60 60)">
        <path d="M60 60 L60 20"/>
        <circle cx="60" cy="60" r="5"/>
    </g>
</svg>
