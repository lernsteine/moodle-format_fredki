{{!
    @template format_fredki/reply

    A reply shown on a card: a person or FredKI.

    Example context (json):
    {
        "isagent": false,
        "agent": null,
        "isfredki": true,
        "text": "Wer hat Ähnliches erlebt?",
        "fulltext": "Wer hat Ähnliches erlebt?",
        "truncated": false,
        "postid": 12,
        "likes": 1,
        "liked": false,
        "author": {"firstname": "Jonas", "fullname": "Jonas Weber", "initials": "JW", "colour": "c2", "hasavatar": false}
    }
}}
{{#isagent}}
<div class="ffk-note ffk-note--agent">
    {{#agent}}<img class="ffk-av ffk-av--agent" src="{{image}}" alt="" style="border-color: {{colour}}">
    <span class="ffk-note__text"><strong>{{name}}</strong> <span class="ffk-ai-chip">{{#str}}aichip, format_fredki{{/str}}</span> {{/agent}}{{#isreplyto}}<span class="ffk-replyto">↳ {{replyto}}</span> {{/isreplyto}}<span data-region="short">{{text}}</span>{{#truncated}}<span data-region="full" hidden>{{fulltext}}</span> <button type="button" class="ffk-more-link" data-action="more" aria-expanded="false">{{#str}}more, format_fredki{{/str}}</button>{{/truncated}}</span>
    {{#postid}}<span class="ffk-note__tools">
        <button type="button" class="ffk-note__answer" data-action="replyto" data-postid="{{postid}}" data-name="{{#agent}}{{name}}{{/agent}}" data-agent="1">{{#str}}answer, format_fredki{{/str}}</button>
        <button type="button" class="ffk-heart{{#liked}} is-on{{/liked}}" data-action="like" data-postid="{{postid}}" aria-pressed="{{#liked}}true{{/liked}}{{^liked}}false{{/liked}}" title="{{#str}}helpful, format_fredki{{/str}}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span data-region="likecount">{{#likes}}{{likes}}{{/likes}}</span><span class="sr-only">{{#str}}helpful, format_fredki{{/str}}</span></button>
    </span>{{/postid}}
</div>
{{/isagent}}
{{^isagent}}
<div class="ffk-note{{#isfredki}} ffk-note--ai{{/isfredki}}">
    {{#isfredki}}<span class="ffk-orb ffk-orb--xs" aria-hidden="true"></span>{{/isfredki}}
    {{^isfredki}}{{#author}}{{> format_fredki/avatar }}{{/author}}{{/isfredki}}
    <span class="ffk-note__text"><strong>{{#isfredki}}FredKI{{/isfredki}}{{^isfredki}}{{author.firstname}}{{/isfredki}}</strong>{{#issharedby}} <small>{{#str}}sharedby, format_fredki, {{sharedby}}{{/str}}</small>{{/issharedby}} {{#isreplyto}}<span class="ffk-replyto">↳ {{replyto}}</span> {{/isreplyto}}<span data-region="short">{{text}}</span>{{#truncated}}<span data-region="full" hidden>{{fulltext}}</span> <button type="button" class="ffk-more-link" data-action="more" aria-expanded="false">{{#str}}more, format_fredki{{/str}}</button>{{/truncated}} {{> format_fredki/pen }}</span>
    {{#postid}}<span class="ffk-note__tools">
        <button type="button" class="ffk-note__answer" data-action="replyto" data-postid="{{postid}}" data-name="{{#isfredki}}FredKI{{/isfredki}}{{^isfredki}}{{author.firstname}}{{/isfredki}}">{{#str}}answer, format_fredki{{/str}}</button>
        <button type="button" class="ffk-heart{{#liked}} is-on{{/liked}}" data-action="like" data-postid="{{postid}}" aria-pressed="{{#liked}}true{{/liked}}{{^liked}}false{{/liked}}" title="{{#str}}helpful, format_fredki{{/str}}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span data-region="likecount">{{#likes}}{{likes}}{{/likes}}</span><span class="sr-only">{{#str}}helpful, format_fredki{{/str}}</span></button>
    </span>{{/postid}}
</div>
{{/isagent}}
