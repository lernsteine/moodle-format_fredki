{{!
    @template format_fredki/askbar

    The private conversation with FredKI, laid over the image like glass.

    Example context (json):
    {
        "hasfredki": true,
        "botname": "FredKI",
        "starters": [{"label": "Gib mir eine Übung", "mode": "ask"}]
    }
}}
{{#hasfredki}}
<div class="ffk-glass" data-region="askbar">
    <form class="ffk-askrow" data-region="askform">
        <span class="ffk-orb" aria-hidden="true">{{> format_fredki/spark }}</span>
        <label class="sr-only" for="ffk-ask-input">{{#str}}askfredki, format_fredki, {{botname}}{{/str}}</label>
        <textarea id="ffk-ask-input" class="ffk-grow" rows="1" autocomplete="off" maxlength="6000" placeholder="{{#str}}askfredki, format_fredki, {{botname}}{{/str}}"></textarea>
        <button class="ffk-go" type="submit" aria-label="{{#str}}send, format_fredki{{/str}}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
    </form>
    <div class="ffk-convo" data-region="convo" aria-live="polite"></div>
    <div class="ffk-chips">
        {{#starters}}<button type="button" class="ffk-chip" data-action="starter" data-mode="{{mode}}"{{#personal}} data-personal="1"{{/personal}}>{{label}}</button>{{/starters}}
    </div>
    <div class="ffk-private">{{#str}}privatehint, format_fredki{{/str}}{{#companionmessageurl}} <a class="ffk-private__link" href="{{companionmessageurl}}">{{#str}}companionmessages_history, format_fredki{{/str}}</a>{{/companionmessageurl}}</div>
</div>
{{/hasfredki}}
