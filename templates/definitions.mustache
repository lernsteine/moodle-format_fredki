{{!
    @template format_fredki/definitions

    The definitions of the group, grouped by first letter, with the letters to jump to.

    Example context (json):
    {"ailabel": "by FredKI", "groups": [{"anchor": "P", "letter": "P", "terms": [{"key": "photosynthesis", "concept": "Photosynthesis", "ai": true, "definition": "How plants make sugar from light."}]}]}
}}
{{#groups}}<section class="ffk-defs__group" id="ffk-def-{{anchor}}"><h3 class="ffk-defs__letter">{{letter}}</h3><dl>{{#terms}}<div class="ffk-defs__item" data-defitem="{{key}}"><dt>{{concept}}{{#ai}} <span class="ffk-ai-chip">{{ailabel}}</span>{{/ai}}</dt><dd>{{definition}}</dd></div>{{/terms}}</dl></section>{{/groups}}
