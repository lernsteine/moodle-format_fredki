{{!
    @template format_fredki/editdialog

    Dialog to correct or take back an own post.

    Example context (json):
    {"title": "Correct your post", "delete": "Delete", "cancel": "Cancel", "save": "Save"}
}}
<form method="dialog" class="ffk-editdialog__in"><h2 class="ffk-editdialog__title">{{title}}</h2><textarea rows="5" aria-label="{{title}}"></textarea><div class="ffk-editdialog__actions"><button type="button" class="ffk-editdialog__delete" value="delete">{{delete}}</button><button type="button" class="ffk-ic ffk-ic--text" value="cancel">{{cancel}}</button><button type="submit" class="ffk-ic ffk-ic--text ffk-ic--reply">{{save}}</button></div></form>
