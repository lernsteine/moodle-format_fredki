{{!
    @template format_fredki/card

    A contribution of the learning group: one image, one thought, quiet actions.

    Example context (json):
    {
        "discussionid": 5,
        "postid": 12,
        "url": "#",
        "subject": "Rohfassung mit KI. Prüfen bleibt bei mir.",
        "image": "https://example.com/lake.jpg",
        "withfredki": false,
        "author": {"firstname": "Lena", "fullname": "Lena Hoffmann", "initials": "LH", "colour": "c1", "hasavatar": false},
        "time": "vor 2 Std.",
        "likes": 12,
        "liked": false,
        "replycount": 1,
        "replies": [],
        "shape": "wide",
        "canreply": true,
        "canconvene": false,
        "hasfredki": true,
        "byfredki": false,
        "type": "question",
        "typelabel": "Frage",
        "hastype": true,
        "voices": [],
        "hasvoices": false,
        "voicenames": "",
        "morevoices": 0,
        "hasmorevoices": false,
        "topicid": 3,
        "topicname": "Langlebige Produkte",
        "hastopic": true,
        "canchangetopic": false
    }
}}
<article class="ffk-card ffk-card--{{shape}}{{#byfredki}} ffk-card--fredki{{/byfredki}}{{#isimpulse}} ffk-card--impulse{{/isimpulse}}" data-region="card" data-canfredki="{{#hasfredki}}1{{/hasfredki}}" data-discussionid="{{discussionid}}" data-postid="{{postid}}" data-lastpost="{{lastpersonpost}}" data-type="{{type}}" data-byfredki="{{#byfredki}}1{{/byfredki}}{{^byfredki}}0{{/byfredki}}">
    <img class="ffk-card__img" src="{{image}}" alt="" loading="lazy"{{#imagestyle}} style="{{imagestyle}}"{{/imagestyle}}>
    <div class="ffk-card__body">
        {{#isimpulse}}<div class="ffk-kicker"><span class="ffk-orb ffk-orb--s" aria-hidden="true"></span>{{#str}}fredkiasks, format_fredki{{/str}}</div>{{/isimpulse}}
        {{^isimpulse}}<div class="ffk-who">
            {{#byfredki}}<span class="ffk-orb ffk-orb--xs" aria-hidden="true"></span><span>FredKI</span>{{/byfredki}}
            {{^byfredki}}{{#author}}{{> format_fredki/avatar }}{{/author}}
            <span>{{author.firstname}}</span>{{/byfredki}}
            <span aria-hidden="true">·</span>
            <span>{{time}}</span>
            {{#hastype}}<span class="ffk-type ffk-type--{{type}}">{{typelabel}}</span>{{/hastype}}
            {{#withfredki}}<span class="ffk-badge">{{> format_fredki/spark }}{{#str}}withfredki, format_fredki{{/str}}</span>{{/withfredki}}
        </div>{{/isimpulse}}
        <div class="ffk-say-row"><a class="ffk-card__say{{#isimpulse}} ffk-card__say--big{{/isimpulse}}" href="#gespraech-{{discussionid}}" data-action="open">{{subject}}</a>{{> format_fredki/pen }}</div>
        {{^isimpulse}}<div class="ffk-topicline" data-region="topicline">{{#hastopic}}<button type="button" class="ffk-topictag" data-action="topicfilter" data-topic="{{topicid}}">{{topicname}}</button>{{/hastopic}}{{#canchangetopic}}<button type="button" class="ffk-topicedit" data-action="topicmenu" aria-haspopup="true" aria-expanded="false" title="{{#hastopic}}{{#str}}topic_change, format_fredki{{/str}}{{/hastopic}}{{^hastopic}}{{#str}}topic_add, format_fredki{{/str}}{{/hastopic}}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{#hastopic}}<path d="M4 20h4L19 9l-4-4L4 16v4z"/>{{/hastopic}}{{^hastopic}}<path d="M12 5v14M5 12h14"/>{{/hastopic}}</svg><span class="{{#hastopic}}sr-only{{/hastopic}}">{{^hastopic}}{{#str}}topic, format_fredki{{/str}}{{/hastopic}}{{#hastopic}}{{#str}}topic_change, format_fredki{{/str}}{{/hastopic}}</span></button>{{/canchangetopic}}</div>{{/isimpulse}}
        {{#hasmaturity}}<div class="ffk-maturity ffk-maturity--{{maturitylevel}}" title="{{#str}}maturity_title, format_fredki{{/str}}"><span class="ffk-maturity__steps" aria-hidden="true">{{#maturitysteps}}<i{{#on}} class="is-on"{{/on}}></i>{{/maturitysteps}}</span><span class="ffk-maturity__label"><span class="sr-only">{{#str}}maturity, format_fredki{{/str}}: </span>{{maturitylabel}}</span></div>{{/hasmaturity}}
        <div class="ffk-card__notes ffk-card__notes--preview" data-region="notes" aria-live="polite">
            {{#replies}}{{> format_fredki/reply }}{{/replies}}
        </div>
        <div class="ffk-card__actions">
            <button type="button" class="ffk-ic ffk-ic--quiet{{#liked}} is-on{{/liked}}" data-action="like" aria-pressed="{{#liked}}true{{/liked}}{{^liked}}false{{/liked}}" title="{{#str}}helpful, format_fredki{{/str}}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
                <span data-region="likecount">{{likes}}</span>
                <span class="sr-only">{{#str}}helpful, format_fredki{{/str}}</span>
            </button>
            {{#canreply}}
            <button type="button" class="ffk-ic ffk-ic--quiet" data-action="reply" aria-expanded="false" title="{{#str}}replyto, format_fredki, {{#byfredki}}FredKI{{/byfredki}}{{^byfredki}}{{author.firstname}}{{/byfredki}}{{/str}}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
                <span class="sr-only">{{#str}}replyto, format_fredki, {{#byfredki}}FredKI{{/byfredki}}{{^byfredki}}{{author.firstname}}{{/byfredki}}{{/str}}</span>
            </button>
            {{/canreply}}
            <a class="ffk-voices" href="#gespraech-{{discussionid}}" data-action="open"{{#hasvoices}} title="{{voicenames}}"{{/hasvoices}}>
                {{#hasvoices}}<span class="ffk-voices__faces" aria-hidden="true">{{#voices}}{{#isagent}}<img class="ffk-av ffk-av--agent" src="{{image}}" alt="" style="border-color: {{colour}}">{{/isagent}}{{#isfredki}}<span class="ffk-orb ffk-orb--xs"></span>{{/isfredki}}{{#isperson}}{{#person}}{{> format_fredki/avatar }}{{/person}}{{/isperson}}{{/voices}}{{#hasmorevoices}}<span class="ffk-av ffk-voices__more">+{{morevoices}}</span>{{/hasmorevoices}}</span>{{/hasvoices}}
                <span><span data-region="replycount">{{replycount}}</span> {{#str}}answers, format_fredki{{/str}}</span>
            </a>
        </div>
        {{#canreply}}
        <form class="ffk-inline" data-region="replyform" hidden>
            <div class="ffk-agentpick" data-region="agentpick" role="group" aria-label="{{#str}}whoanswers, format_fredki{{/str}}" hidden></div>
            <label class="sr-only" for="ffk-reply-{{discussionid}}{{idsuffix}}">{{#str}}reply, format_fredki{{/str}}</label>
            <textarea id="ffk-reply-{{discussionid}}{{idsuffix}}" class="ffk-grow" rows="1" autocomplete="off" maxlength="6000" placeholder="{{#str}}replyplaceholder, format_fredki, {{author.firstname}}{{/str}}"></textarea>
            <button type="submit" class="ffk-ic ffk-ic--solid">{{#str}}send, format_fredki{{/str}}</button>
        </form>
        {{/canreply}}
    </div>
</article>
