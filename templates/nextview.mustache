{{!
    @template format_fredki/nextview

    One more view on request: the agents of the course that have not answered in this conversation yet.

    Example context (json):
    {
        "hasnextagents": true,
        "nextagents": [{"id": 2, "name": "Der Kritiker", "image": "https://example.com/k.jpg", "colour": "#b4432c"}]
    }
}}
{{#hasnextagents}}
<div class="ffk-nextview" data-region="nextview" role="group" aria-label="{{#str}}nextview, format_fredki{{/str}}">
    <span class="ffk-nextview__label">{{#str}}nextview, format_fredki{{/str}}</span>
    {{#nextagents}}
    <button type="button" class="ffk-nextview__btn" data-action="nextagent" data-agentid="{{id}}" title="{{#str}}nextviewfrom, format_fredki, {{name}}{{/str}}" style="--agent: {{colour}}">
        <img src="{{image}}" alt=""><span class="ffk-nextview__name">{{name}}</span>
    </button>
    {{/nextagents}}
</div>
{{/hasnextagents}}
